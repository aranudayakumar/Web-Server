DATABASE_URL=mysql+pymysql://ugandai:localdev@127.0.0.1:3307/ugandai
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_MINUTES=1440
VERIFIED_USERS=farmer@example.com
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=replace-with-responses-api-model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TIMEOUT_SECONDS=30
KNOWLEDGE_TOP_K=3
KNOWLEDGE_SIMILARITY_THRESHOLD=0.25
KNOWLEDGE_INGESTION_DIR=./knowledge_sources
VOICE_MAX_UPLOAD_BYTES=10485760

# VOICE_PROVIDER=openai (default, English-only) or VOICE_PROVIDER=sunbird for Ugandan
# language coverage (Luganda, Acholi, Ateso, Lugbara, Runyankole, Swahili, and more).
# See https://docs.sunbird.ai/languages for the full language list.
VOICE_PROVIDER=openai
SUNBIRD_API_BASE_URL=https://api.sunbird.ai
SUNBIRD_API_TOKEN=replace-with-sunbird-api-token
SUNBIRD_STT_LANGUAGE=lug
SUNBIRD_TTS_LANGUAGE=lug
SUNBIRD_TTS_VOICE=
SUNBIRD_TIMEOUT_SECONDS=30
